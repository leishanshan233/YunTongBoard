# 服务器配置
PORT=3001
NODE_ENV=development

# 跨域配置（前端地址，* 表示允许所有）
CORS_ORIGIN=*

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yuntong_board
DB_USER=root
DB_PASSWORD=1234

# JWT 配置
JWT_SECRET=yuntong_board_jwt_secret_key_2024
JWT_EXPIRES_IN=24h

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# 超时预警配置(小时)
TIMEOUT_HOURS=4
