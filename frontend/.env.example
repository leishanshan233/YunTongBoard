# 环境变量说明
# VITE_API_BASE - 后端 API 地址
# VITE_SOCKET_URL - 后端 WebSocket 地址
# VITE_UPLOAD_URL - 后端静态文件地址

# 开发环境 (npm run dev)
# VITE_API_BASE=http://localhost:3001/api
# VITE_SOCKET_URL=http://localhost:3001
# VITE_UPLOAD_URL=http://localhost:3001/uploads

# 生产环境 (npm run build)
# VITE_API_BASE=http://your-server-ip:3001/api
# VITE_SOCKET_URL=http://your-server-ip:3001
# VITE_UPLOAD_URL=http://your-server-ip:3001/uploads
