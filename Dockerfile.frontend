FROM node:20-alpine AS build

WORKDIR /app
COPY frontend/package*.json ./
RUN npm install

COPY frontend/ .

# 使用构建时的环境变量（可通过 docker build --build-arg 设置）
ARG VITE_API_BASE=http://localhost:3001/api
ARG VITE_SOCKET_URL=http://localhost:3001
ARG VITE_UPLOAD_URL=http://localhost:3001/uploads

ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL
ENV VITE_UPLOAD_URL=$VITE_UPLOAD_URL

RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
